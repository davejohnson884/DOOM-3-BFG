void weapon_machinegun::ReachClearInput() {
    float reach_discard_action;
    reach_discard_action = reachQuickAction();
}

void weapon_machinegun::ReachReadInput() {
    float reach_native_action;
    reach_native_action = reachQuickAction();
    if (reach_native_action != 0) {
        if (!reach_action_locked && !WEAPON_LOWERWEAPON) {
            if (reach_native_action == 1) {
                reach_pending_melee = 1;
                ReachTrace("V request consumed");
            } else if (reach_native_action == 2 && reachGrenadesAvailable() != 0) {
                reach_pending_grenade = 1;
                ReachTrace("G request consumed");
            } else { ReachTrace("G request ignored: no grenade ammo"); }
        }
    }
}
