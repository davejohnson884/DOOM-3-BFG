// Original project code for the released RBDoom3BFG weapon-script interface.
#include "script/reach_controls.script"

object weapon_machinegun : weapon_base {
    float next_attack;
    float bloom;
    float bloom_time;
    float rate;
    float spread_min;
    float spread_max;
    float recovery;
    float reach_pending_melee;
    float reach_action_locked;
    float reach_sprinting;
    float reach_ready_time;
    boolean reach_controls_ready;
    boolean reach_idle_traced;
    float ReachPose();
    void ReachTrace(string reach_message);
    void ReachInstallControls();
    void ReachApplyViewPose();
    void ReachRequestMelee();
    void ReachAmmoDisplay();
    void ReachPrepareRound();
    void EnterCinematic();
    void UpdateSkin();
    void init();
    void Raise();
    void Lower();
    void Idle();
    void Fire();
    void Reload();
    void Sprint();
    void SprintExit();
    void Quick();
    void ExitCinematic();
    void RecoverBloom();
};

void weapon_machinegun::init() {
    ReachTrace("constructor entered");
    // The inherited offset and additive root rotation move the entire rig.
    setModel("viewmodel_reach_ar_present");
    ReachApplyViewPose();
    reach_pending_melee = 0;
    reach_action_locked = 0;
    reach_sprinting = 0;
    reach_ready_time = 0;
    reach_controls_ready = false;
    reach_idle_traced = false;
    next_attack = 0;
    bloom = 0;
    bloom_time = sys.getTime();
    rate = getFloatKey("reach_fire_interval");
    spread_min = getFloatKey("reach_spread_min");
    spread_max = getFloatKey("reach_spread_max");
    recovery = getFloatKey("reach_spread_recovery");
    ReachTrace("constructor tuning loaded; requesting Raise");
    weaponState("Raise", 0);
}

void weapon_machinegun::ReachTrace(string reach_message) {
    if (sys.getcvar("g_debugWeapon") == "1") {
        sys.println("[ReachSwitch r7] " + reach_message);
    }
}

void weapon_machinegun::ReachApplyViewPose() {
    float reach_root_joint;
    reach_root_joint = getJointHandle("origin");
    if (reach_root_joint >= 0) {
        // WORLD adds in model space; an override would discard the original
        // root orientation. Child joints, muzzle markers and clips all follow.
        setJointAngle(reach_root_joint, JOINTMOD_WORLD, '2 -2 0');
        ReachTrace("view pose applied; root=" + reach_root_joint + " offset=(-9 0.5 -0.9) angles=(2 -2 0)");
    } else { ReachTrace("view pose failed: origin joint not found"); }
    if (sys.getcvar("g_debugWeapon") == "1") {
        ReachTrace("camera settings: g_fov=" + sys.getcvar("g_fov") + " g_gunScale=" + sys.getcvar("g_gunScale"));
        ReachTrace("gun position: X=" + sys.getcvar("g_gunX") + " Y=" + sys.getcvar("g_gunY") + " Z=" + sys.getcvar("g_gunZ"));
    }
}

void weapon_machinegun::ReachInstallControls() {
    entity reach_controller;
    entity reach_trigger;
    ReachTrace("control lookup entered");
    reach_controller = sys.getEntity("reach_controls");
    if (reach_controller == $null_entity) {
        ReachTrace("spawning melee controller");
        reach_controller = sys.spawn("reach_input_control");
        ReachTrace("melee controller spawn returned");
    }
    reach_trigger = sys.getEntity("reach_melee_input");
    if (reach_trigger == $null_entity) {
        ReachTrace("spawning melee trigger");
        reach_trigger = sys.spawn("reach_input_melee");
        ReachTrace("melee trigger spawn returned");
    }
    reach_controls_ready = true;
}

void weapon_machinegun::RecoverBloom() {
    float now;
    now = sys.getTime();
    bloom = bloom - (now - bloom_time) / recovery;
    if (bloom < 0) { bloom = 0; }
    bloom_time = now;
}

void weapon_machinegun::Raise() {
    ReachTrace("Raise entered");
    // Also apply after a restored save or a subsequent weapon selection.
    ReachApplyViewPose();
    weaponRising();
    ReachTrace("weaponRising returned; starting raise animation");
    playAnim(ANIMCHANNEL_ALL, "raise");
    ReachTrace("raise animation started; waiting for animation");
    waitUntil(animDone(ANIMCHANNEL_ALL, 2));
    ReachTrace("raise animation completed; requesting Idle");
    weaponState("Idle", 2);
}

void weapon_machinegun::Lower() {
    weaponLowering();
    playAnim(ANIMCHANNEL_ALL, "putaway");
    waitUntil(animDone(ANIMCHANNEL_ALL, 0));
    weaponHolstered();
    waitUntil(WEAPON_RAISEWEAPON);
    weaponState("Raise", 0);
}

void weapon_machinegun::Idle() {
    ReachTrace("Idle entered");
    if (ammoInClip() > 0) { weaponReady(); } else { weaponOutOfAmmo(); }
    playCycle(ANIMCHANNEL_ALL, "idle");
    if (!reach_controls_ready) {
        // Let the raised weapon render before creating auxiliary map entities.
        ReachTrace("idle animation started; yielding before control setup");
        waitFrame();
        ReachTrace("first idle frame resumed");
        ReachInstallControls();
        ReachTrace("control setup completed");
    }
    while (1) {
        RecoverBloom();
        ReachAmmoDisplay();
        if (!reach_idle_traced) { ReachTrace("first counter update returned"); }
        if (WEAPON_LOWERWEAPON) { weaponState("Lower", 2); }
        if (ReachPose() == 2) { weaponState("Quick", 1); }
        if (ReachPose() == 1) { weaponState("Sprint", 2); }
        if (WEAPON_RELOAD && ammoInClip() < clipSize() && ammoAvailable() > ammoInClip()) {
            netReload(); weaponState("Reload", 2);
        }
        if (WEAPON_ATTACK && sys.getTime() >= next_attack && ReachPose() == 0) {
            if (ammoInClip() > 0) { weaponState("Fire", 0); }
            else if (ammoAvailable() > 0 && autoReload()) { netReload(); weaponState("Reload", 2); }
        }
        if (!reach_idle_traced) {
            ReachTrace("first idle input checks returned; yielding");
            reach_idle_traced = true;
        }
        waitFrame();
    }
}

void weapon_machinegun::Fire() {
    RecoverBloom();
    next_attack = sys.getTime() + rate;
    ReachPrepareRound();
    launchProjectiles(1, spread_min + (spread_max - spread_min) * bloom, 0, 1, 1);
    bloom = bloom + 0.1;
    if (bloom > 1) { bloom = 1; }
    playAnim(ANIMCHANNEL_ALL, "fire");
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        ReachAmmoDisplay();
        if (WEAPON_LOWERWEAPON) { weaponState("Lower", 2); }
        if (ReachPose() == 2) { weaponState("Quick", 1); }
        if (ReachPose() == 1) { weaponState("Sprint", 2); }
        if (WEAPON_ATTACK && ammoInClip() > 0 && sys.getTime() >= next_attack) { weaponState("Fire", 0); }
        waitFrame();
    }
    weaponState("Idle", 1);
}

void weapon_machinegun::ReachPrepareRound() {
    entity reach_round;
    float reach_round_speed;
    float reach_round_mass;
    // LaunchProjectiles consumes this same native projectile; no extra round.
    // idProjectile::Launch reads these keys before setting rigid-body mass.
    reach_round = createProjectile();
    if (reach_round != $null_entity) {
        reach_round_speed = sys.vecLength(reach_round.getVectorKey("velocity"));
        if (reach_round_speed > 7200) {
            reach_round_mass = reach_round.getFloatKey("mass") * 7200 / reach_round_speed;
            reach_round.setKey("mass", "" + reach_round_mass);
        }
        reach_round.setKey("push", "0");
    }
}

void weapon_machinegun::Reload() {
    float started;
    boolean filled;
    started = sys.getTime();
    filled = false;
    weaponReloading();
    if (ammoInClip() > 0) { playAnim(ANIMCHANNEL_ALL, "reload_full"); }
    else { playAnim(ANIMCHANNEL_ALL, "reload_empty"); }
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        if (WEAPON_LOWERWEAPON) { weaponState("Lower", 2); }
        if (ReachPose() == 2) { weaponState("Quick", 1); }
        if (ReachPose() == 1) { weaponState("Sprint", 2); }
        if (!filled && sys.getTime() >= started + getFloatKey("reach_reload_fill_time")) {
            addToClip(clipSize());
            filled = true;
            ReachAmmoDisplay();
        }
        waitFrame();
    }
    if (!filled) { addToClip(clipSize()); }
    weaponState("Idle", 2);
}

void weapon_machinegun::Sprint() {
    weaponReady();
    playAnim(ANIMCHANNEL_ALL, "sprint_enter");
    while (!animDone(ANIMCHANNEL_ALL, 0) && ReachPose() == 1) { waitFrame(); }
    if (ReachPose() == 2) { weaponState("Quick", 1); }
    if (ReachPose() != 1) { weaponState("SprintExit", 1); }
    playCycle(ANIMCHANNEL_ALL, "sprint_loop");
    while (ReachPose() == 1) { waitFrame(); }
    if (ReachPose() == 2) { weaponState("Quick", 1); }
    weaponState("SprintExit", 1);
}

void weapon_machinegun::SprintExit() {
    weaponReady();
    playAnim(ANIMCHANNEL_ALL, "sprint_exit");
    while (!animDone(ANIMCHANNEL_ALL, 1)) {
        if (WEAPON_LOWERWEAPON) { weaponState("Lower", 2); }
        if (ReachPose() == 2) { weaponState("Quick", 1); }
        if (ReachPose() == 1) { weaponState("Sprint", 1); }
        if (ReachPose() == 0 && WEAPON_ATTACK && ammoInClip() > 0) { weaponState("Fire", 0); }
        waitFrame();
    }
    weaponState("Idle", 2);
}

void weapon_machinegun::Quick() {
    float reach_hit_time;
    float reach_done_time;
    boolean reach_hit_done;
    ReachTrace("Quick melee entered");
    reach_action_locked = 1;
    reach_pending_melee = 0;
    reach_hit_done = false;
    reach_hit_time = sys.getTime() + getFloatKey("reach_melee_windup_ms") / 1000;
    reach_done_time = reach_hit_time + getFloatKey("reach_melee_recover_ms") / 1000;
    weaponReady();
    playAnim(ANIMCHANNEL_ALL, "melee");
    while (sys.getTime() < reach_done_time) {
        if (WEAPON_LOWERWEAPON) {
            reach_action_locked = 0;
            weaponState("Lower", 2);
        }
        if (!reach_hit_done && sys.getTime() >= reach_hit_time) {
            ReachTrace("melee contact event reached");
            melee();
            reach_hit_done = true;
        }
        ReachAmmoDisplay();
        waitFrame();
    }
    reach_action_locked = 0;
    weaponState("Idle", 2);
}

void weapon_machinegun::ReachRequestMelee() {
    ReachTrace("melee request entered");
    if (!reach_action_locked && !WEAPON_LOWERWEAPON) {
        reach_pending_melee = 1;
        ReachTrace("melee request queued");
    } else { ReachTrace("melee request suppressed while action locked or lowering"); }
}

void weapon_machinegun::ReachAmmoDisplay() {
    float reach_ones;
    reach_ones = ammoInClip() % 10;
    setShaderParm(9, (ammoInClip() - reach_ones) / 100);
    setShaderParm(10, reach_ones / 10);
}

float weapon_machinegun::ReachPose() {
    entity reach_player;
    vector reach_motion;
    float reach_run_requested;
    float reach_clock;
    if (reach_pending_melee) { return 2; }
    reach_player = getOwner();
    reach_motion = reach_player.getMove();
    reach_clock = sys.getTime();
    reach_run_requested = reach_player.getButtons() & 2;
    if (reach_run_requested && sys.vecLength(reach_motion) > 0 && reach_clock >= reach_ready_time) {
        reach_sprinting = 1;
        return 1;
    }
    if (reach_sprinting) {
        reach_sprinting = 0;
        reach_ready_time = reach_clock + getFloatKey("reach_sprint_recover_ms") / 1000;
    }
    if (reach_clock < reach_ready_time) { return 4; }
    return 0;
}

void weapon_machinegun::EnterCinematic() {
    reach_pending_melee = 0;
    reach_action_locked = 1;
}

void weapon_machinegun::UpdateSkin() {
    if (isInvisible()) { setSkin(getKey("skin_invisible")); }
    else { setSkin("reach_ar_clean_display"); }
}

void weapon_machinegun::ExitCinematic() {
    reach_pending_melee = 0;
    reach_action_locked = 0;
    reach_sprinting = 0;
    next_attack = 0;
    weaponState("Idle", 0);
}
